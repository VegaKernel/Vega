{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Vega.sln", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Publish",
      "options": { "cwd": "src/Vega.Runtime" },
      "command": "dotnet",
      "type": "process",
      "args": ["publish", "-c", "Debug", "--self-contained", "true", "-r", "linux-arm64", "/nowarn:CS1591", "/nowarn:CS1587"]
    }
  ]
}
