        <dependency id="SQLitePCLRaw.bundle_e_sqlite3" version="2.1.13" exclude="Build,Analyzers" />
        <dependency id="Terminal.Gui" version="2.4.17" exclude="Build,Analyzers" />
        <dependency id="Terminal.Gui.Editor" version="2.5.7" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
