<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>VegaKernel</id>
    <version>$version$</version>
    <title>Vega</title>
    <authors>VegaKernel</authors>
    <owners>VegaKernel</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE</license>
    <readme>README_EN.md</readme>
    <projectUrl>https://github.com/VegaKernel/Vega</projectUrl>
    <repository type="git" url="https://github.com/VegaKernel/Vega" />
    <description>Vega native Terraria server contracts, runtime libraries, and bundled modules.</description>
    <dependencies>
      <group targetFramework="net11.0">
        <dependency id="MaxMind.GeoIP2" version="6.1.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Data.Sqlite" version="11.0.0-preview.7.26381.103" exclude="Build,Analyzers" />
