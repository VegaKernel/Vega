<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(VersionPrefix)</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>VegaKernel</Authors>
    <Company>VegaKernel</Company>
    <Product>Vega</Product>
    <Copyright>Copyright (c) VegaKernel</Copyright>
    <RepositoryUrl>https://github.com/VegaKernel/Vega</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/VegaKernel/Vega</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README_EN.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <PackageId>$(MSBuildProjectName.Replace('Vega.', 'VegaKernel.'))</PackageId>
    <Title>$(MSBuildProjectName)</Title>
    <Description>Vega native Terraria server component: $(MSBuildProjectName).</Description>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README_EN.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>
</Project>
