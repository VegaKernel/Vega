<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1572;1573;1574;1587;1591</NoWarn>
    <Version>6.1.0</Version>
    <PackageVersion>6.1.1</PackageVersion>
    <AssemblyTitle>TShock for Terraria</AssemblyTitle>
    <Company>TShock Contributors</Company>
    <Product>TShockAPI</Product>
    <Copyright>Copyright © TShock Contributors 2011-2026</Copyright>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Authors>TShockNG Contributors</Authors>
    <Description>Legacy TShock migration assembly retained temporarily while Vega replaces the old runtime path.</Description>
    <PackageId>TShockNG</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" Aliases="BCrypt" />
    <PackageReference Include="GetText.NET" Version="10.0.1" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="TZ.Multiplicity" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\TSAPI\TerrariaServerAPI\TerrariaServerAPI.csproj" />
    <ProjectReference Include="..\Vega.Contracts\Vega.Contracts.csproj" />
    <ProjectReference Include="..\Vega.Core\Vega.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Vega.Core\Accounts\**\*.cs" LinkBase="Migration\Core\Accounts" />
    <Compile Include="..\Vega.Core\Authorization\**\*.cs" LinkBase="Migration\Core\Authorization" />
    <Compile Include="..\Vega.Core\Bans\**\*.cs" LinkBase="Migration\Core\Bans" />
    <Compile Include="..\Vega.Core\Commands\LegacyMonolith\**\*.cs" LinkBase="Migration\Core\Commands" />
    <Compile Include="..\Vega.Core\Infrastructure\Legacy\**\*.cs" LinkBase="Migration\Core\Infrastructure" />
    <Compile Include="..\Vega.Core\Legacy\**\*.cs" LinkBase="Migration\Core\Legacy" />
    <Compile Include="..\Vega.Core\Localization\Legacy\**\*.cs" LinkBase="Migration\Core\Localization" />
    <Compile Include="..\Vega.Core\Logging\Legacy\**\*.cs" LinkBase="Migration\Core\Logging" />
    <Compile Include="..\Vega.Core\Networking\Legacy\**\*.cs" LinkBase="Migration\Core\Networking" />
    <Compile Include="..\Vega.Core\Persistence\**\*.cs" LinkBase="Migration\Core\Persistence" />
    <Compile Include="..\Vega.Core\Players\Legacy\**\*.cs" LinkBase="Migration\Core\Players" />
    <Compile Include="..\Vega.Core\Players\Persistence\**\*.cs" LinkBase="Migration\Core\Players" />
    <Compile Include="..\Vega.Core\Regions\**\*.cs" LinkBase="Migration\Core\Regions" />
    <Compile Include="..\Vega.Core\Restrictions\**\*.cs" LinkBase="Migration\Core\Restrictions" />
    <Compile Include="..\Vega.Core\Security\**\*.cs" LinkBase="Migration\Core\Security" />
    <Compile Include="..\Vega.Core\Updates\Legacy\**\*.cs" LinkBase="Migration\Core\Updates" />
    <Compile Include="..\Vega.Core\Worlds\**\*.cs" LinkBase="Migration\Core\Worlds" />
    <Compile Include="..\Vega.Runtime\CLI\Legacy\**\*.cs" LinkBase="Migration\Runtime\CLI" />
    <Compile Include="..\Vega.Runtime\Networking\LegacySockets\**\*.cs" LinkBase="Migration\Runtime\Networking" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="HttpServer">
      <HintPath>..\..\external\legacy\HttpServer.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\external\legacy\HttpServer.dll">
      <Link>HttpServer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>lib/$(TargetFramework)/</PackagePath>
    </None>
  </ItemGroup>
</Project>
