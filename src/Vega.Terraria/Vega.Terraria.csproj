<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Vega.Terraria</RootNamespace>
    <AssemblyName>Vega.Terraria</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vega.Contracts\Vega.Contracts.csproj" />
    <ProjectReference Include="..\TerraRuntime.Schematics\TerraRuntime.Schematics.csproj" />
    <PackageReference Include="TerrariaRuntime" Version="1.1.7" />
    <PackageReference Include="Multiplicity" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vega.Server" />
    <InternalsVisibleTo Include="Vega.Runtime.Tests" />
    <InternalsVisibleTo Include="Vega.WorldImage.Benchmarks" />
    <InternalsVisibleTo Include="Vega.PacketPipeline.Benchmarks" />
    <InternalsVisibleTo Include="Vega.NativeTcp.Benchmarks" />
    <InternalsVisibleTo Include="Vega.MixedGameplay.Benchmarks" />
  </ItemGroup>

</Project>
