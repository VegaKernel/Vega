<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vega.Terraria</RootNamespace>
    <AssemblyName>Vega.Terraria</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MonoMod_ReallySkipCheckTargetRuntime>true</MonoMod_ReallySkipCheckTargetRuntime>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vega.Contracts\Vega.Contracts.csproj" />
    <PackageReference Include="OTAPI.Upcoming" Version="3.3.12" />
    <PackageReference Include="Multiplicity" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vega.Runtime.Tests" />
    <InternalsVisibleTo Include="Vega.WorldImage.Benchmarks" />
  </ItemGroup>
</Project>
