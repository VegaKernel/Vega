<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net11.0</TargetFramework>
		<RootNamespace>Vega.Runtime</RootNamespace>
		<AssemblyName>Vega.Server</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
		<DebugType>embedded</DebugType>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<IsPackable>false</IsPackable>
		<PublishAot>false</PublishAot>
		<PublishReadyToRun Condition="'$(PublishReadyToRun)' == ''">false</PublishReadyToRun>
		<TieredCompilation>true</TieredCompilation>
		<TieredPGO>true</TieredPGO>
		<MonoMod_ReallySkipCheckTargetRuntime>true</MonoMod_ReallySkipCheckTargetRuntime>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Vega.Runtime.Tests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Vega.Core\Vega.Core.csproj" />
		<ProjectReference Include="..\Vega.PluginSdk\Vega.PluginSdk.csproj" />
		<ProjectReference Include="..\Vega.Backups\Vega.Backups.csproj" />
		<ProjectReference Include="..\Vega.Cluster\Vega.Cluster.csproj" />
		<ProjectReference Include="..\Vega.Modules.Administration\Vega.Modules.Administration.csproj" />
		<ProjectReference Include="..\Vega.Modules.AutoWorldCleaner\Vega.Modules.AutoWorldCleaner.csproj" />
		<ProjectReference Include="..\Vega.Modules.Chests\Vega.Modules.Chests.csproj" />
		<ProjectReference Include="..\Vega.Modules.CustomItems\Vega.Modules.CustomItems.csproj" />
		<ProjectReference Include="..\Vega.Modules.Mentions\Vega.Modules.Mentions.csproj" />
		<ProjectReference Include="..\Vega.Modules.Pvp\Vega.Modules.Pvp.csproj" />
		<ProjectReference Include="..\Vega.Modules.Scenes\Vega.Modules.Scenes.csproj" />
		<ProjectReference Include="..\Vega.Modules.Wipe\Vega.Modules.Wipe.csproj" />
		<ProjectReference Include="..\Vega.Operations\Vega.Operations.csproj" />
		<ProjectReference Include="..\Vega.Persistence\Vega.Persistence.csproj" />
		<ProjectReference Include="..\Vega.Regions\Vega.Regions.csproj" />
		<ProjectReference Include="..\Vega.Sandboxes\Vega.Sandboxes.csproj" />
		<ProjectReference Include="..\Vega.Terraria\Vega.Terraria.csproj" />
		<ProjectReference Include="..\Vega.TerminalUI\Vega.TerminalUI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\config\tui.json" Link="config\tui.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\modules.json" Link="config\modules.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\debug-api.json" Link="config\debug-api.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\database.json" Link="config\database.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\world-clock.json" Link="config\world-clock.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\auto-world-cleaner.json" Link="config\auto-world-cleaner.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\world-maintenance.json" Link="config\world-maintenance.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\security.json" Link="config\security.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\sandboxes.json" Link="config\sandboxes.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\backups.json" Link="config\backups.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\soft-restart.json" Link="config\soft-restart.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\..\config\server.json" Link="config\server.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<Target Name="ArrangeDevRuntime" AfterTargets="PostBuildEvent">
		<RemoveDir Directories="$(OutDir)libs;$(OutDir)ServerPlugins" />
		<ItemGroup>
			<DevServerPlugins Include="$(OutDir)Vega.Modules.*" />
			<DevLibraries Include="$(OutDir)*" Exclude="$(OutDir)Vega.Server*;$(OutDir)Vega.Modules.*" />
		</ItemGroup>
		<MakeDir Directories="$(OutDir)libs;$(OutDir)ServerPlugins" />
		<Move SourceFiles="@(DevServerPlugins)" DestinationFolder="$(OutDir)ServerPlugins" />
		<Move SourceFiles="@(DevLibraries)" DestinationFolder="$(OutDir)libs" />
	</Target>

	<Target Name="ArrangeTerrariaRuntimeMonoModCore" AfterTargets="CopyTerrariaRuntimeNet11MonoModCore">
		<Move SourceFiles="$(OutDir)MonoMod.Core.dll"
			DestinationFolder="$(OutDir)libs"
			Condition="Exists('$(OutDir)MonoMod.Core.dll')" />
	</Target>

	<Target Name="ArrangePublishedRuntime" AfterTargets="Publish">
		<RemoveDir Directories="$(PublishDir)libs;$(PublishDir)ServerPlugins" />
		<ItemGroup>
			<PublishedServerPlugins Include="$(PublishDir)Vega.Modules.*" />
			<PublishedLibraries Include="$(PublishDir)*" Exclude="$(PublishDir)Vega.Server*;$(PublishDir)Vega.Modules.*" />
		</ItemGroup>
		<MakeDir Directories="$(PublishDir)libs;$(PublishDir)ServerPlugins" />
		<Move SourceFiles="@(PublishedServerPlugins)" DestinationFolder="$(PublishDir)ServerPlugins" />
		<Move SourceFiles="@(PublishedLibraries)" DestinationFolder="$(PublishDir)libs" />
	</Target>

	<Target Name="RejectNativeAotServerPublish" BeforeTargets="PrepareForPublish" Condition="'$(PublishAot)' == 'true'">
		<Error Text="Vega.Server requires CoreCLR for managed ServerPlugins, collectible AssemblyLoadContext hot reload and soft restart. Publish a fixed-function executable separately before enabling NativeAOT." />
	</Target>
</Project>
