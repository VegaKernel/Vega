<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" Aliases="BCrypt" />
    <PackageReference Include="GetText.NET" Version="10.0.1" />
    <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="TZ.Multiplicity" Version="2.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\TSAPI\TerrariaServerAPI\TerrariaServerAPI.csproj" />
    <ProjectReference Include="..\TShockNG.Contracts\TShockNG.Contracts.csproj" />
  </ItemGroup>

  <!--
    Architecture-only moves place transitional legacy sources under Core immediately.
    Until each subsystem is detached from TShockAPI plugin models, those files are
    compiled by TShockAPI through linked source entries instead of creating a
    forbidden Core -> TShockAPI reference. Remove entries from this list as the
    corresponding subsystem becomes a real Core implementation.
  -->
  <ItemGroup>
    <Compile Remove="Accounts\**\*.cs" />
    <Compile Remove="Authorization\**\*.cs" />
    <Compile Remove="Bans\**\*.cs" />
    <Compile Remove="Commands\LegacyMonolith\**\*.cs" />
    <Compile Remove="Infrastructure\Legacy\**\*.cs" />
    <Compile Remove="Legacy\**\*.cs" />
    <Compile Remove="Localization\Legacy\**\*.cs" />
    <Compile Remove="Logging\Legacy\**\*.cs" />
    <Compile Remove="Networking\Legacy\**\*.cs" />
    <Compile Remove="Persistence\**\*.cs" />
    <Compile Remove="Players\Legacy\**\*.cs" />
    <Compile Remove="Players\Persistence\**\*.cs" />
    <Compile Remove="Regions\**\*.cs" />
    <Compile Remove="Restrictions\**\*.cs" />
    <Compile Remove="Security\**\*.cs" />
    <Compile Remove="Updates\Legacy\**\*.cs" />
    <Compile Remove="Worlds\**\*.cs" />
  </ItemGroup>
</Project>
